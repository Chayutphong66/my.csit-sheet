# Example contract only. Store real values in the staging secret manager.
NODE_ENV=production
STAGING_SAFETY_TOKEN=ISOLATED-NON-PRODUCTION
STAGING_ENVIRONMENT_ID=csit-sheet-staging
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://staging_user:replace-me@staging-db.example.invalid:5432/csit_sheet_staging?sslmode=require
DATABASE_POOL_MAX=5
STORAGE_DRIVER=supabase
SUPABASE_URL=https://staging-project.example.invalid
SUPABASE_SECRET_KEY=replace-with-staging-only-secret
SUPABASE_STORAGE_BUCKET=csit-sheet-staging
JWT_SECRET=replace-with-independent-staging-secret-at-least-32-characters
APP_BASE_URL=https://staging.csit-sheet.example.invalid
ALLOWED_ORIGINS=https://staging.csit-sheet.example.invalid
COOKIE_SAME_SITE=strict
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
VITE_API_URL=/api
EMAIL_VERIFICATION_ENFORCED=false
