{
  "name": "csit-sheet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:import-courses": "npm run db:import-courses --workspace backend",
    "db:cleanup-files": "npm run db:cleanup-files --workspace backend",
    "db:storage-report": "npm run db:storage-report --workspace backend",
    "lint": "eslint backend/src backend/test frontend/src frontend/test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --workspace backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:visual": "node scripts/visual-qa.mjs",
    "start:production": "npm run db:migrate && npm run start --workspace backend",
    "start": "npm run start --workspace backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4"
  }
}
