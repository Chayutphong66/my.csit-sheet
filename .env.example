# Local development defaults. Production values belong in the hosting provider,
# never in this file or another committed .env file.
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://127.0.0.1:5173
# For production, set a long random value. Example generation:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
# Optional one-time production bootstrap: the matching registration becomes ADMIN only while no admin exists.
# Remove this Netlify environment variable after creating the first administrator.
BOOTSTRAP_ADMIN_EMAIL=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Optional: comma-separated additional origins. Netlify's URL and deploy-preview URL are allowed automatically.
ALLOWED_ORIGINS=
# Local development only. Netlify Database injects NETLIFY_DB_URL automatically; never copy it here.
DATABASE_PATH=
# Frontend API URL. Leave unset when the backend serves the production frontend.
VITE_API_URL=/api
