# Local development defaults. Production values belong in the hosting provider,
# never in this file or another committed .env file.
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://127.0.0.1:5173
# For production, set a long random value. Example generation:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Optional: comma-separated list for production CORS, e.g. https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
# Required in production: absolute path on persistent storage.
DATABASE_PATH=
# Frontend API URL. Leave unset when the backend serves the production frontend.
VITE_API_URL=/api
