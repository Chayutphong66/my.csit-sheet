# Local development: inject these into the backend process (no secrets here).
NODE_ENV=development
PORT=8080
DATABASE_DRIVER=sqlite
# DATABASE_PATH=absolute-path-to-your-local-sqlite-file
STORAGE_DRIVER=database
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
DATABASE_POOL_MAX=5
# JWT_SECRET=configure-a-private-random-secret-outside-source-control
# BOOTSTRAP_ADMIN_EMAIL=owner-email-with-an-explicit-bootstrap-policy

# Supabase integration/backend configuration; do not commit real values.
# NODE_ENV=production
# DATABASE_DRIVER=postgres
# DATABASE_URL=configure-private-postgresql-connection-url
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=configure-private-sb_secret-key
# SUPABASE_STORAGE_BUCKET=documents
# Future same-origin Railway deployment URL.
# ALLOWED_ORIGINS=https://your-railway-domain.example
# COOKIE_SAME_SITE=strict
# TEST_DATABASE_URL=dedicated-empty-local-test-postgresql-url

# Frontend PUBLIC build configuration ONLY; never put server secrets in VITE_*.
# Keep /api for the future same-origin Railway full-stack deployment.
VITE_API_URL=/api
